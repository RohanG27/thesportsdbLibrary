{
  "name": "sportsdb-graphql-schema",
  "version": "0.1.0-dev",
  "description": "GraphQL schema (SDL) for TheSportsDB API: every record type, relationships and queries, each annotated with the v1/v2 endpoints that resolve it.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema.graphql": "./schema.graphql"
  },
  "files": [
    "dist",
    "schema.graphql"
  ],
  "sideEffects": false,
  "keywords": [
    "thesportsdb",
    "graphql",
    "schema",
    "sdl",
    "sports"
  ],
  "license": "MIT",
  "peerDependencies": {
    "graphql": "^16.0.0 || ^17.0.0"
  },
  "peerDependenciesMeta": {
    "graphql": {
      "optional": true
    }
  },
  "scripts": {
    "generate": "node tools/gen-schema.mjs",
    "build": "node tools/gen-schema.mjs --check && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@graphql-tools/merge": "^9.2.6",
    "@graphql-tools/mock": "^9.1.16",
    "@graphql-tools/schema": "^10.1.3",
    "@types/node": "^26.6.4",
    "graphql": "^17.0.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
