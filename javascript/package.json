{
  "name": "thesportsdb-client",
  "version": "0.1.0",
  "description": "JavaScript/TypeScript client for TheSportsDB API v1 and v2: typed models, rate limiting, retries, caching. No dependencies.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "keywords": [
    "thesportsdb",
    "sports",
    "api",
    "client"
  ],
  "license": "MIT",
  "author": "RohanG27",
  "homepage": "https://github.com/RohanG27/thesportsdbLibrary/tree/main/javascript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RohanG27/thesportsdbLibrary.git",
    "directory": "javascript"
  },
  "bugs": {
    "url": "https://github.com/RohanG27/thesportsdbLibrary/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "generate": "node tools/gen-models.mjs",
    "sync-fixtures": "node tools/sync-fixtures.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
