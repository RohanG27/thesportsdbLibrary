{
    "name": "rohang27/thesportsdb-client",
    "description": "PHP client for TheSportsDB API v1 and v2: typed models, rate limiting, retries, caching.",
    "type": "library",
    "keywords": [
        "thesportsdb",
        "sports",
        "api",
        "client"
    ],
    "homepage": "https://rohang27.github.io/thesportsdbLibrary/",
    "license": "MIT",
    "authors": [
        {
            "name": "RohanG27",
            "homepage": "https://github.com/RohanG27"
        }
    ],
    "support": {
        "issues": "https://github.com/RohanG27/thesportsdbLibrary/issues",
        "source": "https://github.com/RohanG27/thesportsdbLibrary/tree/main/php",
        "docs": "https://rohang27.github.io/thesportsdbLibrary/api/php/index.html"
    },
    "require": {
        "php": ">=8.2",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "psr/simple-cache": "^3.0"
    },
    "suggest": {
        "ext-curl": "for the default HTTP transport",
        "psr/simple-cache": "to cache responses in any PSR-16 cache (Psr16ResponseCache)"
    },
    "autoload": {
        "psr-4": {
            "RohanG27\\TheSportsDb\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RohanG27\\TheSportsDb\\Tests\\": "tests/"
        },
        "files": [
            "tests/Support.php"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    }
}
